{application, mcc, [
    {description, "Mea Culpa; Configuration"},
    {vsn, "0.0.1"},
    {registered, [mcc]},
    {mod, {mcc_app, []}},
    {applications, [
        kernel,
        stdlib,
        sasl,
        yamerl
    ]},
    {optional_applications, [magicbeam]},
    {env, []},
    {modules, []},
    {licenses, ["MIT"]},
    {links, [{"GitHub", "https://github.com/otakup0pe/mcc"}]}
]}.
